; Synthetic Texture2DArray variant of shared_sampler.spvasm. It was produced by editing that module
; by hand: both images become arrayed (OpTypeImage ... 2D 2 1 0 1) and the sample coordinate becomes a
; float3 holding u, v and array layer 0. One sampler variable still feeds both depth-comparison and
; ordinary sampling. Equivalent HLSL:
;
;   [[vk::binding(0, 0)]] Texture2DArray<float> depthTexture;
;   [[vk::binding(1, 0)]] Texture2DArray<float> valueTexture;
;   [[vk::binding(2, 0)]] SamplerComparisonState cmpSampler;
;   [[vk::binding(3, 0)]] SamplerState plainSampler;
;   [[vk::binding(4, 0)]] RWStructuredBuffer<float> results;
;
;   const float3 uv = float3(0.25f, 0.25f, 0.0f);
;   results[0] = depthTexture.SampleCmpLevelZero(cmpSampler, uv, 0.25f);
;   results[1] = depthTexture.SampleCmpLevelZero(cmpSampler, uv, 0.75f);
;   results[2] = valueTexture.SampleLevel(plainSampler, uv, 0.0f);
;
; SPIR-V
; Version: 1.5
; Generator: Google spiregg; 0
; Bound: 46
; Schema: 0
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %depthTexture %valueTexture %cmpSampler %plainSampler %results
               OpExecutionMode %main LocalSize 1 1 1
