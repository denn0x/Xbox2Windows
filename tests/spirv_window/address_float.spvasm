OpCapability Shader
OpCapability Int64
OpCapability PhysicalStorageBufferAddresses
OpExtension "SPV_KHR_physical_storage_buffer"
OpMemoryModel PhysicalStorageBuffer64 GLSL450
OpEntryPoint GLCompute %main "main" %user_data
OpExecutionMode %main LocalSize 1 1 1
OpDecorate %rt_uint ArrayStride 4
OpDecorate %rt_float ArrayStride 4
OpDecorate %words ArrayStride 4
OpDecorate %UserData Block
OpMemberDecorate %UserData 0 Offset 0
%void = OpTypeVoid
%bool = OpTypeBool
%uint = OpTypeInt 32 0
%float = OpTypeFloat 32
%ulong = OpTypeInt 64 0
%fn = OpTypeFunction %void
%c0 = OpConstant %uint 0
%c1 = OpConstant %uint 1
%c2 = OpConstant %uint 2
%c3 = OpConstant %uint 3
%c4 = OpConstant %uint 4
%shift32 = OpConstant %uint 32
%four = OpConstant %ulong 4
%eight = OpConstant %ulong 8
%rt_uint = OpTypeRuntimeArray %uint
%rt_float = OpTypeRuntimeArray %float
%_ptr_PSB_arr = OpTypePointer PhysicalStorageBuffer %rt_uint
%_ptr_PSB_uint = OpTypePointer PhysicalStorageBuffer %uint
%_ptr_PSB_arrf = OpTypePointer PhysicalStorageBuffer %rt_float
%_ptr_PSB_float = OpTypePointer PhysicalStorageBuffer %float
%words = OpTypeArray %uint %c4
%UserData = OpTypeStruct %words
%_ptr_PC_UserData = OpTypePointer PushConstant %UserData
%_ptr_PC_uint = OpTypePointer PushConstant %uint
%user_data = OpVariable %_ptr_PC_UserData PushConstant
%main = OpFunction %void None %fn
%entry = OpLabel
%base_low_ptr = OpAccessChain %_ptr_PC_uint %user_data %c0 %c0
%base_low = OpLoad %uint %base_low_ptr
%low64 = OpUConvert %ulong %base_low
%base_high_ptr = OpAccessChain %_ptr_PC_uint %user_data %c0 %c3
%base_high = OpLoad %uint %base_high_ptr
%high64 = OpUConvert %ulong %base_high
%shifted = OpShiftLeftLogical %ulong %high64 %shift32
%base = OpBitwiseOr %ulong %low64 %shifted
%array = OpConvertUToPtr %_ptr_PSB_arrf %base
%first_source = OpAccessChain %_ptr_PSB_float %array %c1
%second_source = OpAccessChain %_ptr_PSB_float %array %c2
%third_source = OpAccessChain %_ptr_PSB_float %array %c3
%operand_ptr = OpAccessChain %_ptr_PC_uint %user_data %c0 %c1
%operand_bits = OpLoad %uint %operand_ptr
%operand = OpBitcast %float %operand_bits
%output_ptr = OpAccessChain %_ptr_PC_uint %user_data %c0 %c2
%output_low = OpLoad %uint %output_ptr
%output_address = OpUConvert %ulong %output_low
%output_first = OpConvertUToPtr %_ptr_PSB_float %output_address
%output_second_address = OpIAdd %ulong %output_address %four
%output_second = OpConvertUToPtr %_ptr_PSB_float %output_second_address
%output_tail_address = OpIAdd %ulong %output_address %eight
%output_tail = OpConvertUToPtr %_ptr_PSB_arrf %output_tail_address
%first = OpLoad %float %first_source Aligned 4
%second = OpLoad %float %second_source Aligned 4
%third = OpLoad %float %third_source Aligned 4
OpStore %output_first %first Aligned 4
OpStore %output_second %second Aligned 4
%tail_0 = OpAccessChain %_ptr_PSB_float %output_tail %c0
OpStore %tail_0 %third Aligned 4
%tail_1 = OpAccessChain %_ptr_PSB_float %output_tail %c1
OpStore %tail_1 %operand Aligned 4
OpReturn
OpFunctionEnd
